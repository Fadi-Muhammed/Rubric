# Rubric — environment template. Copy to `.env` and fill in.
# `.env` is gitignored; NEVER commit real keys.

# --- Supabase (optional; app runs mock-first without these) -----------------
# From your Supabase project: Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Flip to "false" to use the Supabase data layer instead of the in-memory seed.
# Any other value (or missing) keeps the safe mock default.
VITE_USE_MOCK=true

# --- AI assists via OpenRouter (server-side Edge Function) ------------------
# Deployed function URL, e.g. https://YOUR-PROJECT.supabase.co/functions/v1/ai
# Leave blank to use the deterministic mock AI. The OpenRouter key itself is a
# Supabase *function secret*, NOT a VITE_ var — it must never reach the browser:
#   supabase secrets set OPENROUTER_API_KEY=sk-or-...
#   supabase secrets set OPENROUTER_MODEL=anthropic/claude-3.5-sonnet   # optional
VITE_AI_ENDPOINT=
